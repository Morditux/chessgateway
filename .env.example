# ChessGateway Docker — variables d'environnement hôte pour docker-compose.yml

# Dossier hôte contenant les binaires UCI (Stockfish, etc.)
# Monté dans le conteneur en /engines:ro — la config conteneur doit pointer sur /engines/<binaire>
ENGINES_HOST_DIR=/home/mordicus/chess/engines

# Fichier hôte contenant les clés clients (auth.clients_file).
# Reste sur l'hôte, jamais copié dans l'image (voir .dockerignore).
# Monté en :ro sur /etc/chessgateway/clients.config — commente si auth.enabled=false.
# Doit être lisible par l'UID 999 du conteneur : chmod 644 ou chgrp 999 && chmod 640.
CLIENTS_FILE_HOST=/home/mordicus/chessgateway/clients.config

# Port hôte exposé (conteneur écoute toujours 9000)
CHESSGATEWAY_PORT=9000
